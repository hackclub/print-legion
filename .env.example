# Airtable personal access token on the printlegion_2 base.
# Scopes: data.records:read for the public site; add data.records:write so
# printers can edit their profile from the dashboard.
AIRTABLE_API_KEY=pat_xxx   # AIRTABLE_KEY also works
AIRTABLE_BASE_ID=appH3Qc3ucJh5RIcX
# Optional tuning (seconds)
PROFILE_CACHE_SECONDS=21600
LIVE_CACHE_SECONDS=15

# Hack Club Auth app (auth.hackclub.com) for the printer dashboard.
# Scopes on the app: email slack_id. Callback: <site>/oauth/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# HCA_REDIRECT_URI=https://printlegion.hackclub.com/oauth/callback  # only if auto-detect is wrong

# Dashboard (optional): override the "I sent a print" form link.
# SENT_PRINT_FORM_URL=https://forms.hackclub.com/sent-print
