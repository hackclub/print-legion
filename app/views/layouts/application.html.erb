<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "print legion" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Print Legion is an international network of 3D printers around the world from Hack Club!">
    <%= csrf_meta_tags %>
    <link rel="icon" href="<%= image_path(content_for(:favicon).presence || "calicat-1.png") %>" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://v5.airtableusercontent.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
    <link rel="preload" href="/fonts/terminal-grotesque.woff2" as="font" type="font/woff2" crossorigin>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "app", defer: true %>
  </head>
  <body class="<%= content_for(:body_class) %>" data-live="<%= content_for(:live) %>">
    <%= render "shared/loader" %>
    <div class="page">
      <%= render "shared/nav" %>
      <main class="main"><%= yield %></main>
      <%= render "shared/footer" %>
    </div>
  </body>
</html>
