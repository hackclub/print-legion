<% content_for :title, "#{@guides[@guide].downcase} · print legion" %>
<% content_for :favicon, "docs.png" %>
<% content_for :logo, "docs.png" %>
<%= render "shared/back" %>
<div class="title-row"><h1 class="page-title">docs</h1></div>
<div class="docs">
  <nav class="docs-nav" aria-label="guides">
    <% @guides.each do |slug, label| %>
      <a class="docs-tab<%= " is-active" if slug == @guide %>" href="<%= doc_path(slug) %>"<%= ' aria-current="page"'.html_safe if slug == @guide %>><%= label %></a>
    <% end %>
  </nav>
  <article class="prose">
    <h1><%= @guides[@guide] %></h1>
    <%= render "pages/guides/#{@guide}" %>
  </article>
</div>
