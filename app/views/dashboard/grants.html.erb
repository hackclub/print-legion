<% content_for :title, "your grants · print legion" %>
<% content_for :live, "dashboard" %>
<% content_for :favicon, "guyblue.png" %>
<% content_for :logo, "guyblue.png guyred.png guygreen.png" %>
<%= render "dashboard/header", title: "your grants", active: :grants %>

<section class="dash-section dash-grants-page">
  <div class="dash-card dash-hcb">
    <div>
      <span class="control-label">email (and HCB email)</span>
      <p class="dash-hcb-email"><%= @account.email || "not set" %></p>
      <p class="dash-hint">Grants are sent to this address on HCB.</p>
    </div>
    <%= form_with url: dashboard_email_path, method: :patch, class: "dash-hcb-form" do |f| %>
      <label class="dash-field">
        <span class="control-label">change it</span>
        <%= f.email_field :email, value: @account.email, required: true, maxlength: PrinterAccount::EMAIL_MAX, autocomplete: "email", class: "dash-input" %>
      </label>
      <%= f.submit "update", class: "cta cta-cyan dash-save" %>
    <% end %>
  </div>

  <% if @grants.nil? %>
    <p class="dash-empty">Couldn't load your grants right now. Try again in a minute.</p>
  <% else %>
    <% if @grants.empty? %><p class="dash-empty">No grants issued to you yet.</p><% end %>
    <% if @grants.any? %>
    <% purposes = @grants.filter_map { _1[:purpose] }.tally.sort_by { |pu, n| [-n, pu.downcase] }.map(&:first) %>
    <div class="controls dash-controls">
      <div class="control">
        <span class="control-label" id="purpose-label">purpose</span>
        <div class="dropdown" data-dropdown="purpose">
          <button type="button" class="dropdown-button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="purpose-label">
            <span class="dropdown-value">all purposes</span>
            <%= image_tag "chevron-down.svg", alt: "", class: "dropdown-chevron", width: 16, height: 16 %>
          </button>
          <ul class="dropdown-menu" role="listbox" hidden>
            <li role="option" data-value="" aria-selected="true">all purposes</li>
            <% purposes.each do |pu| %><li role="option" data-value="<%= pu %>"><%= pu %></li><% end %>
          </ul>
        </div>
      </div>
    </div>
    <% end %>
    <ol class="dash-grants" id="dash-grants">
      <% @grants.each do |g| %>
        <li class="dash-grant" data-purpose="<%= g[:purpose] %>">
          <span class="dash-grant-amount"><%= g[:amount] ? number_to_currency(g[:amount], precision: (g[:amount] % 1).zero? ? 0 : 2) : "–" %></span>
          <span class="dash-grant-info">
            <span class="dash-grant-purpose"><%= g[:purpose] || "grant card" %></span>
            <span class="dash-print-meta"><%= g[:issued] ? "issued #{g[:issued].strftime("%-d %b %Y")}" : "issue date unknown" %></span>
          </span>
          <% if g[:url] %><a class="pill pill-cyan" href="<%= g[:url] %>" target="_blank" rel="noopener">view card</a><% end %>
        </li>
      <% end %>
      <%# Request a new card. Counts as a "Shipping Grant" for the purpose filter. %>
      <li class="dash-grant dash-grant-request<%= " is-pending" if @pending_request %>" data-purpose="Shipping Grant">
        <span class="dash-grant-info">
          <span class="dash-grant-purpose">need a shipping grant?</span>
          <span class="dash-print-meta">
            <% if @pending_request %>
              You asked<%= " on #{@pending_request[:created].strftime("%-d %b %Y")}" if @pending_request[:created] %>. Waiting to be sent.
            <% else %>
              Request a card to cover the cost of sending out prints. It goes to <%= @account.email || "your email" %>.
            <% end %>
          </span>
        </span>
        <% if @pending_request %>
          <span class="cta cta-orange dash-cta is-disabled" aria-disabled="true"><%= image_tag "benchy.png", alt: "", class: "cta-icon cta-icon-cat" %>request pending</span>
        <% else %>
          <%= button_to dashboard_grant_request_path, method: :post, class: "cta cta-orange dash-cta", form_class: "dash-request-form", data: { request_grant: true } do %>
            <%= image_tag "benchy.png", alt: "", class: "cta-icon cta-icon-cat" %>request a shipping grant
          <% end %>
        <% end %>
      </li>
    </ol>
  <% end %>
</section>
