<% content_for :title, "your stats · print legion" %>
<% content_for :live, "dashboard" %>
<% content_for :favicon, "guyblue.png" %>
<% content_for :logo, "guyblue.png guyred.png guygreen.png" %>
<%= render "dashboard/header", title: "your stats", active: :stats %>
<%
  shipped = @prints.select { _1[:approved] && !_1[:duplicate] }
  countries = shipped.filter_map { _1[:country] }.uniq(&:downcase)
  pending = @prints.count { !_1[:approved] && !_1[:duplicate] }
%>

<div class="dash-tiles">
  <div class="dash-tile"><span class="dash-num"><%= shipped.size %></span><span>prints shipped</span></div>
  <div class="dash-tile"><span class="dash-num"><%= number_with_precision(@account.total_grams / 1000.0, precision: 2) %></span><span>kg printed</span></div>
  <div class="dash-tile"><span class="dash-num"><%= countries.size %></span><span><%= "country".pluralize(countries.size) %> reached</span></div>
  <div class="dash-tile">
    <span class="dash-num"><%= @rank ? "##{@rank[:place]}" : "–" %></span>
    <span><%= @rank ? "of #{@rank[:of]} printers" : (@account.active ? "not ranked yet" : "rank: active printers only") %></span>
  </div>
</div>

<section class="dash-section">
  <div class="dash-section-head">
    <h2 class="dash-heading">your prints</h2>
    <% if pending.positive? %><span class="pill pill-orange"><%= pending %> waiting for approval</span><% end %>
  </div>
  <% if @prints.empty? %>
    <p class="dash-empty">No prints logged yet. Your first one will show up here.</p>
  <% else %>
    <% events = @prints.filter_map { _1[:event] }.tally.sort_by { |e, n| [-n, e.downcase] }.map(&:first) %>
    <div class="controls dash-controls">
      <div class="control">
        <span class="control-label" id="status-label">status</span>
        <div class="dropdown" data-dropdown="status">
          <button type="button" class="dropdown-button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="status-label">
            <span class="dropdown-value">all statuses</span>
            <%= image_tag "chevron-down.svg", alt: "", class: "dropdown-chevron", width: 16, height: 16 %>
          </button>
          <ul class="dropdown-menu" role="listbox" hidden>
            <li role="option" data-value="" aria-selected="true">all statuses</li>
            <li role="option" data-value="approved">✅ approved</li>
            <li role="option" data-value="pending">⏳ pending</li>
            <li role="option" data-value="duplicate">♻️ duplicate</li>
          </ul>
        </div>
      </div>
      <div class="control">
        <span class="control-label" id="event-label">event</span>
        <div class="dropdown" data-dropdown="event">
          <button type="button" class="dropdown-button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="event-label">
            <span class="dropdown-value">all events</span>
            <%= image_tag "chevron-down.svg", alt: "", class: "dropdown-chevron", width: 16, height: 16 %>
          </button>
          <ul class="dropdown-menu" role="listbox" hidden>
            <li role="option" data-value="" aria-selected="true">all events</li>
            <% events.each do |ev| %><li role="option" data-value="<%= ev %>"><%= ev %></li><% end %>
          </ul>
        </div>
      </div>
      <div class="control">
        <span class="control-label" id="psort-label">sort by</span>
        <div class="dropdown" data-dropdown="psort">
          <button type="button" class="dropdown-button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="psort-label">
            <span class="dropdown-value">📅 date</span>
          </button>
          <button type="button" class="sort-flip" aria-label="reverse order" title="reverse order" aria-pressed="false"><%= image_tag "sort.svg", alt: "", width: 16, height: 16 %></button>
          <ul class="dropdown-menu" role="listbox" hidden>
            <li role="option" data-value="date" aria-selected="true">📅 date</li>
            <li role="option" data-value="weight">🏋️ weight (g)</li>
            <li role="option" data-value="shipping">📦 shipping ($)</li>
          </ul>
        </div>
      </div>
      <div class="control control-search">
        <label class="control-label" for="print-search">search</label>
        <div class="search">
          <%= image_tag "search.svg", alt: "", width: 16, height: 16 %>
          <input id="print-search" type="search" placeholder="person, tracking, date, event..." autocomplete="off" spellcheck="false">
          <button type="button" class="search-clear" aria-label="clear search" hidden><%= image_tag "x.svg", alt: "", width: 16, height: 16 %></button>
        </div>
      </div>
    </div>
    <p class="dash-empty" id="dash-prints-empty" hidden>No prints match.</p>
    <ol class="dash-prints" id="dash-prints">
      <% @prints.each do |p| %>
        <% who = p[:recipient] && @recipients[p[:recipient]] %>
        <% status = p[:duplicate] ? "duplicate" : (p[:approved] ? "approved" : "pending") %>
        <li class="dash-print" data-status="<%= status %>" data-event="<%= p[:event] %>"
            data-date="<%= p[:created]&.to_i || 0 %>" data-grams="<%= p[:grams] %>" data-shipping="<%= p[:shipping] %>"
            data-search="<%= [p[:event], p[:country], who&.name, p[:recipient], p[:tracking],
                              p[:created]&.strftime("%-d %b %Y"), p[:created]&.strftime("%-d %B %Y"), p[:created]&.strftime("%Y-%m-%d"), status].compact.join(" ").downcase %>">
          <% if p[:image] %>
            <img class="dash-thumb" src="<%= p[:image] %>" alt="" loading="lazy">
          <% else %>
            <%= image_tag "no-image-cube.png", alt: "", class: "dash-thumb is-placeholder", loading: "lazy" %>
          <% end %>
          <div class="dash-print-main">
            <div class="dash-print-title">
              <%= p[:event] ? "for #{p[:event]}" : "a print" %><%= " → #{p[:country]}" if p[:country] %>
            </div>
            <% if (rid = p[:recipient]) %>
              <% who = @recipients[rid] %>
              <div class="dash-recipient">
                <span class="dash-recipient-label">to</span>
                <% if who&.avatar %>
                  <img class="dash-recipient-avatar" src="<%= who.avatar %>" alt="" loading="lazy" referrerpolicy="no-referrer">
                <% else %>
                  <span class="dash-recipient-avatar is-blank"><%= (who&.name || "?").first.upcase %></span>
                <% end %>
                <span class="dash-recipient-name"><%= who&.name || "a Hack Clubber" %></span>
                <span class="dash-mono">(<%= rid %>)</span>
              </div>
            <% end %>
            <div class="dash-print-meta">
              <%= p[:created]&.strftime("%-d %b %Y") || "no date" %>
              <% if p[:grams].positive? %> · <%= number_with_precision(p[:grams], precision: 0, delimiter: ",") %> g<% end %>
              <% if p[:shipping].positive? %> · <%= number_to_currency(p[:shipping]) %> shipping<% end %>
              <% if p[:tracking] %> · tracking <span class="dash-mono"><%= p[:tracking].truncate(28) %></span><% end %>
            </div>
          </div>
          <div class="dash-print-side">
            <% status = p[:duplicate] ? ["duplicate", "is-dup"] : p[:approved] ? ["approved", "is-ok"] : ["pending", "is-wait"] %>
            <span class="dash-status <%= status[1] %>"><%= status[0] %></span>
            <% if p[:message_url] %><a class="pill pill-cyan" href="<%= p[:message_url] %>" target="_blank" rel="noopener">slack</a><% end %>
            <% if p[:grant_url] %><a class="pill pill-orange" href="<%= p[:grant_url] %>" target="_blank" rel="noopener">grant</a><% end %>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
