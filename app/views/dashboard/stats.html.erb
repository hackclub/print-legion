<% content_for :title, "your stats · print legion" %>
<% content_for :live, "dashboard" %>
<% content_for :favicon, "guyblue.png" %>
<% content_for :logo, "guyblue.png guyred.png guygreen.png" %>
<%= render "dashboard/header", title: "your stats", active: :stats %>
<%
  shipped = @prints.select { _1[:approved] && !_1[:duplicate] }
  countries = shipped.filter_map { _1[:country] }.uniq(&:downcase)
  pending = @prints.count { !_1[:approved] && !_1[:duplicate] }
%>

<div class="dash-tiles">
  <div class="dash-tile"><span class="dash-num"><%= shipped.size %></span><span>prints shipped</span></div>
  <div class="dash-tile"><span class="dash-num"><%= number_with_precision(@account.total_grams / 1000.0, precision: 2) %></span><span>kg printed</span></div>
  <div class="dash-tile"><span class="dash-num"><%= countries.size %></span><span><%= "country".pluralize(countries.size) %> reached</span></div>
  <div class="dash-tile">
    <span class="dash-num"><%= @rank ? "##{@rank[:place]}" : "–" %></span>
    <span><%= @rank ? "of #{@rank[:of]} printers" : (@account.active ? "not ranked yet" : "rank: active printers only") %></span>
  </div>
</div>

<section class="dash-section">
  <div class="dash-section-head">
    <h2 class="dash-heading">your prints</h2>
    <% if pending.positive? %><span class="pill pill-orange"><%= pending %> waiting for approval</span><% end %>
  </div>
  <% if @prints.empty? %>
    <p class="dash-empty">No prints logged yet. Your first one will show up here.</p>
  <% else %>
    <ol class="dash-prints">
      <% @prints.each do |p| %>
        <li class="dash-print">
          <% if p[:image] %>
            <img class="dash-thumb" src="<%= p[:image] %>" alt="" loading="lazy">
          <% else %>
            <%= image_tag "no-image-cube.png", alt: "", class: "dash-thumb is-placeholder", loading: "lazy" %>
          <% end %>
          <div class="dash-print-main">
            <div class="dash-print-title">
              <%= p[:event] ? "for #{p[:event]}" : "a print" %><%= " → #{p[:country]}" if p[:country] %>
            </div>
            <div class="dash-print-meta">
              <%= p[:created]&.strftime("%-d %b %Y") || "no date" %>
              <% if p[:grams].positive? %> · <%= number_with_precision(p[:grams], precision: 0, delimiter: ",") %> g<% end %>
              <% if p[:shipping].positive? %> · <%= number_to_currency(p[:shipping]) %> shipping<% end %>
              <% if p[:tracking] %> · tracking <span class="dash-mono"><%= p[:tracking].truncate(28) %></span><% end %>
            </div>
          </div>
          <div class="dash-print-side">
            <% status = p[:duplicate] ? ["duplicate", "is-dup"] : p[:approved] ? ["approved", "is-ok"] : ["pending", "is-wait"] %>
            <span class="dash-status <%= status[1] %>"><%= status[0] %></span>
            <% if p[:message_url] %><a class="pill pill-cyan" href="<%= p[:message_url] %>" target="_blank" rel="noopener">slack</a><% end %>
            <% if p[:grant_url] %><a class="pill pill-orange" href="<%= p[:grant_url] %>" target="_blank" rel="noopener">grant</a><% end %>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>

<section class="dash-section" id="grants">
  <div class="dash-section-head">
    <h2 class="dash-heading">grants</h2>
    <% if @grants&.any? %><span class="pill pill-orange"><%= pluralize(@grants.size, "card") %></span><% end %>
  </div>

  <div class="dash-card dash-hcb">
    <div>
      <span class="control-label">email (and HCB email)</span>
      <p class="dash-hcb-email"><%= @account.email || "not set" %></p>
      <p class="dash-hint">Grants are sent to this address on HCB.</p>
    </div>
    <%= form_with url: dashboard_email_path, method: :patch, class: "dash-hcb-form" do |f| %>
      <label class="dash-field">
        <span class="control-label">change it</span>
        <%= f.email_field :email, value: @account.email, required: true, maxlength: PrinterAccount::EMAIL_MAX, autocomplete: "email", class: "dash-input" %>
      </label>
      <%= f.submit "update", class: "cta cta-cyan dash-save" %>
    <% end %>
  </div>

  <% if @grants.nil? %>
    <p class="dash-empty">Couldn't load your grants right now. Try again in a minute.</p>
  <% elsif @grants.empty? %>
    <p class="dash-empty">No grants issued to you yet.</p>
  <% else %>
    <ol class="dash-grants">
      <% @grants.each do |g| %>
        <li class="dash-grant">
          <span class="dash-grant-purpose"><%= g[:purpose] || "grant card" %></span>
          <span class="dash-print-meta"><%= g[:issued] ? "issued #{g[:issued].strftime("%-d %b %Y")}" : "" %></span>
          <% if g[:url] %><a class="pill pill-cyan" href="<%= g[:url] %>" target="_blank" rel="noopener">open card</a><% end %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
