<%= render "shared/back" %>
<div class="title-row">
  <h1 class="page-title"><%= title %></h1>
  <nav class="dash-tabs" aria-label="dashboard">
    <% { profile: dashboard_path, stats: dashboard_stats_path, grants: dashboard_grants_path }.each do |tab, path| %>
      <a class="docs-tab<%= " is-active" if active == tab %>" href="<%= path %>"<%= ' aria-current="page"'.html_safe if active == tab %>><%= tab %></a>
    <% end %>
    <%= button_to "sign out", logout_path, method: :delete, class: "docs-tab dash-signout-button", form_class: "dash-signout" %>
  </nav>
</div>
<% if flash[:notice] %><p class="flash flash-ok" role="status"><%= flash[:notice] %></p><% end %>
<% if flash[:alert] %><p class="flash flash-bad" role="alert"><%= flash[:alert] %></p><% end %>
